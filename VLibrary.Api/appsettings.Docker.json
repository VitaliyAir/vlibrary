{
  // Container settings (ASPNETCORE_ENVIRONMENT=Docker, see D:\Family\Developer\VDocker). No secrets here: the connection
  // string, MediatR:LicenseKey and VStorage:ClientSecret come from the stack's .env file.
  "Authentication": {
    // The issuer as the browser sees it; the API itself reaches Keycloak through InternalAuthority.
    "Authority": "http://localhost:8083/realms/VEco",
    "InternalAuthority": "http://host.docker.internal:8083",
    "RequireHttpsMetadata": false
  },
  "VStorage": {
    // The VStorage container on the stack network; the token endpoint is derived from Authority.
    "BaseUrl": "http://vstorage-api:8080"
  },
  "Import": {
    "TempFolder": "/tmp/vlibrary-import"
  },
  "Metadata": {
    // DjVuLibre from the image (apt djvulibre-bin); ddjvu (covers) is found next to djvused.
    "DjvusedPath": "/usr/bin/djvused"
  }
}
