{
  "Authentication": {
    "Authority": "",
    "ClientId": "vlibrary",
    "RequiredRole": "Owner",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "OpenApi": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5175", "http://127.0.0.1:5175" ]
  },
  "VStorage": {
    "BaseUrl": "",
    "BucketName": "vlibrary-books",
    "Timeout": "00:10:00",
    "TokenEndpoint": "",
    "ClientId": "vlibrary-api",
    "Audience": "vstorage",
    "Scope": "vstorage-audience",
    "DownloadLinkSeconds": 300
  },
  "Import": {
    "MaxFileBytes": 1073741824,
    "TempFolder": "",
    "ExcludedFolders": [ "node_modules", ".git", ".svn", ".vs", "bin", "obj" ]
  },
  "Covers": {
    "Width": 300,
    "MaxHeight": 450,
    "JpegQuality": 80
  },
  "Metadata": {
    "DjvusedPath": "",
    "DdjvuPath": "",
    "PdfIsbnPagesFromStart": 5,
    "PdfIsbnPagesFromEnd": 3
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/vlibrary-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] [{ApplicationName}] {SourceContext} {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "ApplicationName": "vlibrary-api"
    }
  },
  "AllowedHosts": "*"
}
