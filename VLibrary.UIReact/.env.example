# Base URL of the API for production builds. Leave empty when the UI is served from the same origin
# or when using the Vite dev server (it proxies /api to http://localhost:5080).
VITE_API_URL=

# Keycloak realm address and the client id of this app (production builds need both; dev values are in .env.development).
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=vlibrary
